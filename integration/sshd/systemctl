#!/bin/sh
# Stands in for systemctl in the integration test image, which has no
# systemd. It supports only what gst's service manager runs: it starts a
# unit's ExecStart in the background and stops it again. Restart= and the
# other unit settings are not emulated. With --user it works on the user's
# units, and without it on the system's, as root.
set -eu
if [ "${1-}" = --user ]; then
	shift
	units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
	state="$HOME/.systemctl-shim"
else
	units=/etc/systemd/system
	state=/run/systemctl-shim
fi
mkdir -p "$state"

running() {
	[ -f "$state/$1.pid" ] && kill -0 "$(cat "$state/$1.pid")" 2>/dev/null
}

stop() {
	if running "$1"; then
		pid=$(cat "$state/$1.pid")
		kill "$pid"
		while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done
	fi
	rm -f "$state/$1.pid"
}

start() {
	running "$1" && return 0
	unit=$1
	exec_start=$(sed -n 's/^ExecStart=//p' "$units/$unit")
	# gst quotes every argument; the test paths need no further unescaping.
	eval "set -- $exec_start"
	setsid "$@" </dev/null >>"$state/$unit.log" 2>&1 &
	echo $! >"$state/$unit.pid"
}

case "$1" in
daemon-reload | enable) ;;
start) start "$2" ;;
restart) stop "$2"; start "$2" ;;
disable) [ "$2" = --now ] && stop "$3" ;;
*) echo "systemctl shim: unsupported command: $*" >&2; exit 1 ;;
esac
