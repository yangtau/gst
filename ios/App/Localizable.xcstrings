        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Link"
          }
        }
      }
    },
    "Log": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志"
          }
        }
      }
    },
    "Machines": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器"
          }
        }
      }
